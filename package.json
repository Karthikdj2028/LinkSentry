{
  "name": "linksentry",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests-firestore/firestore.rules.test.js\"",
    "test:e2e": "npm --prefix e2e run test:headless",
    "test:web": "node selenium-tests/run-web-tests.js",
    "test:web:headed": "HEADLESS=false node selenium-tests/run-web-tests.js",
    "test:web:report": "node selenium-tests/generate-excel-report.js",
    "test:web:inventory": "node selenium-tests/generate-test-case-inventory.js",
    "test:mobile": "node frontend/appium-tests/run-mobile-tests.js",
    "test:mobile:report": "node frontend/appium-tests/generate-excel-report.js",
    "test:mobile:inventory": "node frontend/appium-tests/generate-test-case-inventory.js",
    "test:load": "node load-tests/run-load-tests.js",
    "test:load:baseline-300": "node load-tests/baseline-300-users.js",
    "test:load:report": "node load-tests/generate-load-excel-report.js",
    "test:load:inventory": "node load-tests/load-test-inventory.js",
    "test:security": "node vulnerability-tests/scripts/security-runner.js",
    "test:security:report": "node vulnerability-tests/generate-security-report.js",
    "test:security:inventory": "node vulnerability-tests/generate-security-inventory.js",
    "test:inventory": "node scripts/generate-complete-inventory.js"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "jsqr": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "appium": "^3.6.0",
    "appium-uiautomator2-driver": "^8.4.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "exceljs": "^4.4.0",
    "globals": "^17.7.0",
    "selenium-webdriver": "^4.47.0",
    "vite": "^8.2.0",
    "webdriverio": "^9.30.1"
  }
}
